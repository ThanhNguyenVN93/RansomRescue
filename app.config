<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup>
    <!-- Yêu cầu .NET 4.6.1+ — Windows tự hiện dialog "Download .NET" nếu thiếu -->
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1"/>
  </startup>
  <appSettings>
    <!-- Timeout (ms) cho mỗi HTTP request khi tải DB -->
    <add key="DbFetchTimeoutMs" value="8000"/>
    <!-- URL chính: NMR decryption tools page -->
    <add key="DbUrlMain" value="https://www.nomoreransom.org/en/decryption-tools.html"/>
    <!-- URL fallback: GitHub raw db.json của project -->
    <add key="DbUrlFallback" value="https://raw.githubusercontent.com/ThanhNguyenVN93/RansomRescue/main/db/db.json"/>
    <!-- Cache location: trông như Windows component, ransom ít đụng -->
    <add key="CachePath" value="%ProgramData%\Microsoft\Windows\RR\db_cache.json"/>
    <!-- Cache hợp lệ trong bao nhiêu ngày -->
    <add key="CacheMaxAgeDays" value="7"/>
    <!-- Số luồng quét tối đa -->
    <add key="ScanThreads" value="2"/>
    <!-- Online submit: số lần retry và delay (ms) -->
    <add key="SubmitRetryCount" value="3"/>
    <add key="SubmitRetryDelayMs" value="3000"/>
    <!-- Email fallback khi submit thất bại -->
    <add key="FallbackEmail" value="support@id-ransomware.malwarehunterteam.com"/>
    <!-- URL tải Kaspersky KVRT — cập nhật nếu link chết -->
    <add key="KvrtUrl" value="https://media.kaspersky.com/utilities/VirusUtilities/EN/kvrt.exe"/>
    <!-- Số ngày trước khi tự refresh DB ngầm -->
    <add key="DbAutoRefreshDays" value="7"/>
  </appSettings>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral"/>
        <bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="13.0.0.0"/>
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
